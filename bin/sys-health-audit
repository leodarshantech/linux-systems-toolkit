#!/usr/bin/env bash
# ==============================================================================
# sys-health-audit — Linux system health & security posture auditor
#
# Checks CPU load, memory, swap, disk space, inodes, failed systemd units,
# zombie processes and SSH authentication failures in one pass.
#
# Part of linux-systems-toolkit: https://github.com/leodarshantech/linux-systems-toolkit
# Author: Leo Darshan (@leodarshantech)
# License: MIT
# ==============================================================================

set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
for lib in "${self%/*}/../lib/common.sh" "${self%/*}/../lib/linux-systems-toolkit/common.sh"; do
    if [[ -r "$lib" ]]; then
        # shellcheck source=../lib/common.sh
        . "$lib"
        break
    fi
done
[[ -n "${LST_VERSION:-}" ]] || { echo "${0##*/}: cannot find lib/common.sh" >&2; exit 3; }

# Default thresholds (percent unless noted)
CPU_WARN=80;   CPU_CRIT=90
MEM_WARN=85;   MEM_CRIT=95
SWAP_WARN=75;  SWAP_CRIT=95
DISK_WARN=85;  DISK_CRIT=95
INODE_WARN=85; INODE_CRIT=95
SSH_WARN=100   # failed logins in the last 24h

# Local, block-backed filesystem types worth auditing.
FS_TYPES=(ext2 ext3 ext4 xfs btrfs f2fs zfs vfat)

JSON=0
QUIET=0
COLOR=1

usage() {
    cat <<EOF
Usage: ${LST_PROG} [OPTIONS]

Audit CPU load, memory, swap, disk space, inodes, failed systemd units,
zombie processes and SSH authentication failures in a single pass.

Options:
  -j, --json            Print one JSON document on a single line
  -q, --quiet           Print nothing; only set the exit status
      --no-color        Disable colored output (NO_COLOR is also honored)
  -c, --cpu W[:C]       15-min load average per CPU, %  (default: ${CPU_WARN}:${CPU_CRIT})
  -m, --mem W[:C]       Memory in use, %                (default: ${MEM_WARN}:${MEM_CRIT})
  -s, --swap W[:C]      Swap in use, %                  (default: ${SWAP_WARN}:${SWAP_CRIT})
  -d, --disk W[:C]      Filesystem space used, %        (default: ${DISK_WARN}:${DISK_CRIT})
  -i, --inode W[:C]     Filesystem inodes used, %       (default: ${INODE_WARN}:${INODE_CRIT})
      --ssh N           Failed SSH logins in 24h that raise WARN (default: ${SSH_WARN})
  -v, --version         Print version and exit
  -h, --help            Print this help and exit

A single value (e.g. --disk 80) changes only the warning threshold.

Exit status (Nagios plugin convention):
  0 OK    1 WARNING    2 CRITICAL    3 UNKNOWN (usage or internal error)

Examples:
  ${LST_PROG}
  ${LST_PROG} --json | jq .metrics.disks
  ${LST_PROG} --disk 80:90 --quiet || echo "needs attention"
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)    usage; exit 0 ;;
        -v|--version) echo "${LST_PROG} ${LST_VERSION}"; exit 0 ;;
        -j|--json)    JSON=1 ;;
        -q|--quiet)   QUIET=1 ;;
        --no-color)   COLOR=0 ;;
        -c|--cpu)     lst_need_arg "$@"; lst_thresholds "$1" "$2" CPU_WARN CPU_CRIT; shift ;;
        -m|--mem)     lst_need_arg "$@"; lst_thresholds "$1" "$2" MEM_WARN MEM_CRIT; shift ;;
        -s|--swap)    lst_need_arg "$@"; lst_thresholds "$1" "$2" SWAP_WARN SWAP_CRIT; shift ;;
        -d|--disk)    lst_need_arg "$@"; lst_thresholds "$1" "$2" DISK_WARN DISK_CRIT; shift ;;
        -i|--inode)   lst_need_arg "$@"; lst_thresholds "$1" "$2" INODE_WARN INODE_CRIT; shift ;;
        --ssh)        lst_need_arg "$@"; lst_uint "$1" "$2" SSH_WARN; shift ;;
        *)            lst_usage_error "unknown option '$1'" ;;
    esac
    shift
done

lst_colors "$COLOR"
STATUS=OK

# ==============================================================================
# Collection
# ==============================================================================

collect_host() {
    HOST="$(lst_hostname)"
    read -r KERNEL < "${LST_ROOT}/proc/sys/kernel/osrelease"
    read -r UPTIME_SECS _ < "${LST_ROOT}/proc/uptime"
    UPTIME_SECS="${UPTIME_SECS%.*}"
}

# Load average counts runnable *and* uninterruptible (D state) tasks, so it is
# normalized against every online CPU in the system, not the process affinity.
check_cpu() {
    local online="${LST_ROOT}/sys/devices/system/cpu/online" range
    local -a ranges=()
    CPU_COUNT=0
    if [[ -r "$online" ]]; then
        IFS=, read -ra ranges < "$online"
        for range in "${ranges[@]}"; do
            CPU_COUNT=$(( CPU_COUNT + ${range#*-} - ${range%-*} + 1 ))
        done
    fi
    (( CPU_COUNT > 0 )) || CPU_COUNT="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"

    read -r LOAD_1 LOAD_5 LOAD_15 _ < "${LST_ROOT}/proc/loadavg"
    LOAD_PCT="$(awk -v l="$LOAD_15" -v c="$CPU_COUNT" 'BEGIN { printf "%.0f", l / c * 100 }')"
    CPU_STATUS="$(lst_threshold "$LOAD_PCT" "$CPU_WARN" "$CPU_CRIT")"
    lst_worse STATUS "$CPU_STATUS"
}

# Memory in use = MemTotal - MemAvailable, i.e. page cache and reclaimable slab
# are treated as free, which is what the kernel can actually hand out.
check_memory() {
    local key val mem_free=0 buffers=0 cached=0
    MEM_TOTAL=0 MEM_AVAIL='' SWAP_TOTAL=0 SWAP_FREE=0
    while read -r key val _; do
        case "$key" in
            MemTotal:)     MEM_TOTAL=$val ;;
            MemAvailable:) MEM_AVAIL=$val ;;
            MemFree:)      mem_free=$val ;;
            Buffers:)      buffers=$val ;;
            Cached:)       cached=$val ;;
            SwapTotal:)    SWAP_TOTAL=$val ;;
            SwapFree:)     SWAP_FREE=$val ;;
        esac
    done < "${LST_ROOT}/proc/meminfo"
    # Kernels older than 3.14 lack MemAvailable; approximate it.
    [[ -n "$MEM_AVAIL" ]] || MEM_AVAIL=$(( mem_free + buffers + cached ))

    MEM_USED=$(( MEM_TOTAL - MEM_AVAIL ))
    MEM_PCT="$(awk -v u="$MEM_USED" -v t="$MEM_TOTAL" 'BEGIN { printf "%.1f", (t > 0 ? u / t * 100 : 0) }')"
    MEM_STATUS="$(lst_threshold "${MEM_PCT%.*}" "$MEM_WARN" "$MEM_CRIT")"
    lst_worse STATUS "$MEM_STATUS"

    SWAP_USED=$(( SWAP_TOTAL - SWAP_FREE ))
    SWAP_PCT="$(awk -v u="$SWAP_USED" -v t="$SWAP_TOTAL" 'BEGIN { printf "%.1f", (t > 0 ? u / t * 100 : 0) }')"
    SWAP_STATUS="$(lst_threshold "${SWAP_PCT%.*}" "$SWAP_WARN" "$SWAP_CRIT")"
    lst_worse STATUS "$SWAP_STATUS"
}

# One entry per filesystem source: btrfs subvolumes and bind mounts of the same
# device are folded together so a full disk is reported once, not N times.
check_disks() {
    local -a df_types=()
    local t src fstype size used avail pct mount inodes iused ipct i
    local -A index=()
    for t in "${FS_TYPES[@]}"; do df_types+=(-t "$t"); done

    D_SRC=() D_TYPE=() D_MOUNTS=() D_SIZE=() D_USED=() D_AVAIL=() D_PCT=() D_STATUS=()
    I_TOTAL=() I_USED=() I_PCT=() I_STATUS=()
    DISK_STATUS=OK INODE_STATUS=OK

    # df -P reports sizes in 1024-byte blocks; the mount point is the last
    # column, so `read` keeps any spaces in it intact.
    while read -r src fstype size used avail pct mount; do
        i="${index[$src]:-}"
        if [[ -n "$i" ]]; then
            D_MOUNTS[i]+=$'\n'"$mount"
            continue
        fi
        i=${#D_SRC[@]}
        index[$src]=$i
        pct="${pct%\%}"
        lst_is_uint "$pct" || pct=0
        D_SRC+=("$src") D_TYPE+=("$fstype") D_MOUNTS+=("$mount")
        D_SIZE+=("$size") D_USED+=("$used") D_AVAIL+=("$avail") D_PCT+=("$pct")
        D_STATUS+=("$(lst_threshold "$pct" "$DISK_WARN" "$DISK_CRIT")")
        lst_worse DISK_STATUS "${D_STATUS[i]}"
        I_TOTAL+=(0) I_USED+=(0) I_PCT+=('') I_STATUS+=(OK)
    done < <(df -P -T "${df_types[@]}" 2>/dev/null | tail -n +2)

    # btrfs, zfs and vfat allocate inodes dynamically and report "-" here.
    while read -r src inodes iused _ ipct mount; do
        i="${index[$src]:-}"
        [[ -n "$i" && "${I_PCT[i]}" == '' ]] || continue
        ipct="${ipct%\%}"
        if ! lst_is_uint "$ipct" || ! lst_is_uint "$inodes" || (( inodes == 0 )); then
            continue
        fi
        I_TOTAL[i]=$inodes I_USED[i]=$iused I_PCT[i]=$ipct
        I_STATUS[i]="$(lst_threshold "$ipct" "$INODE_WARN" "$INODE_CRIT")"
        lst_worse INODE_STATUS "${I_STATUS[i]}"
    done < <(df -P -i "${df_types[@]}" 2>/dev/null | tail -n +2)

    lst_worse STATUS "$DISK_STATUS"
    lst_worse STATUS "$INODE_STATUS"
}

check_systemd() {
    FAILED_UNITS=()
    if ! lst_systemd_booted; then
        SYSTEMD_STATUS=SKIP
        return
    fi
    mapfile -t FAILED_UNITS < <(
        systemctl list-units --state=failed --no-legend --plain --no-pager 2>/dev/null \
            | awk 'NF { print $1 }'
    )
    SYSTEMD_STATUS=OK
    (( ${#FAILED_UNITS[@]} == 0 )) || SYSTEMD_STATUS=CRIT
    lst_worse STATUS "$SYSTEMD_STATUS"
}

# /proc/PID/stat is "pid (comm) state ppid ...", and comm may itself contain
# spaces or ')' — so the state is parsed from after the *last* ')'.
check_zombies() {
    local pid ppid comm parent
    Z_PID=() Z_PPID=() Z_COMM=() Z_PARENT=()
    while IFS=$'\t' read -r pid ppid comm; do
        parent='?'
        read -r parent 2>/dev/null < "${LST_ROOT}/proc/${ppid}/comm" || true
        Z_PID+=("$pid") Z_PPID+=("$ppid") Z_COMM+=("$comm") Z_PARENT+=("$parent")
    done < <(
        awk '{
            rest = $0; sub(/^.*\) /, "", rest); split(rest, f, " ")
            if (f[1] != "Z") next
            comm = $0; sub(/^[0-9]+ \(/, "", comm); sub(/\) [^)]*$/, "", comm)
            printf "%s\t%s\t%s\n", $1, f[2], comm
        }' "${LST_ROOT}"/proc/[0-9]*/stat 2>/dev/null || true
    )
    ZOMBIE_STATUS=OK
    (( ${#Z_PID[@]} == 0 )) || ZOMBIE_STATUS=WARN
    lst_worse STATUS "$ZOMBIE_STATUS"
}

# Counts one line per failed authentication attempt. OpenSSH >= 9.8 logs as
# "sshd-session", older releases as "sshd"; unit names differ per distro, so
# match on the syslog identifier instead.
check_ssh() {
    local log ips
    SSH_FAILS=0 SSH_TOP=() SSH_NOTE=''
    if ! command -v journalctl >/dev/null 2>&1; then
        SSH_STATUS=SKIP SSH_NOTE='journalctl not available'
        return
    fi
    if [[ -z "$(journalctl --system --quiet --no-pager --lines=1 --output=cat 2>/dev/null)" ]]; then
        SSH_STATUS=SKIP SSH_NOTE='system journal not readable (run as root or join systemd-journal)'
        return
    fi
    log="$(journalctl --system --quiet --no-pager --output=cat --since=-24h \
        --identifier=sshd --identifier=sshd-session 2>/dev/null || true)"
    ips="$(awk '/^Failed [^ ]+ for / {
        for (i = 1; i < NF; i++) if ($i == "from") { print $(i + 1); break }
    }' <<< "$log")"
    if [[ -n "$ips" ]]; then
        SSH_FAILS="$(grep -c . <<< "$ips")"
        mapfile -t SSH_TOP < <(sort <<< "$ips" | uniq -c | sort -rn | head -n 5 | awk '{ print $2 "\t" $1 }')
    fi
    SSH_STATUS=OK
    (( SSH_FAILS < SSH_WARN )) || SSH_STATUS=WARN
    lst_worse STATUS "$SSH_STATUS"
}

collect_host
check_cpu
check_memory
check_disks
check_systemd
check_zombies
check_ssh

EXIT_CODE="$(lst_exit_code "$STATUS")"
(( QUIET )) && exit "$EXIT_CODE"

# ==============================================================================
# JSON report
# ==============================================================================

render_json() {
    local i mounts disks=() zombies=() top=() ip count inode_pct
    local -a mount_list

    for i in "${!D_SRC[@]}"; do
        mapfile -t mount_list <<< "${D_MOUNTS[i]}"
        mounts="$(lst_json_strs "${mount_list[@]}")"
        inode_pct="${I_PCT[i]:-null}"
        disks+=("$(printf '{"source":%s,"type":%s,"mounts":%s,"size_kib":%s,"used_kib":%s,"avail_kib":%s,"used_pct":%s,"status":"%s","inodes_total":%s,"inodes_used":%s,"inodes_used_pct":%s,"inodes_status":"%s"}' \
            "$(lst_json_str "${D_SRC[i]}")" "$(lst_json_str "${D_TYPE[i]}")" "$mounts" \
            "${D_SIZE[i]}" "${D_USED[i]}" "${D_AVAIL[i]}" "${D_PCT[i]}" "${D_STATUS[i]}" \
            "${I_TOTAL[i]}" "${I_USED[i]}" "$inode_pct" "${I_STATUS[i]}")")
    done

    for i in "${!Z_PID[@]}"; do
        zombies+=("$(printf '{"pid":%s,"ppid":%s,"comm":%s,"parent_comm":%s}' \
            "${Z_PID[i]}" "${Z_PPID[i]}" "$(lst_json_str "${Z_COMM[i]}")" "$(lst_json_str "${Z_PARENT[i]}")")")
    done

    for i in "${SSH_TOP[@]}"; do
        IFS=$'\t' read -r ip count <<< "$i"
        top+=("$(printf '{"ip":%s,"failures":%s}' "$(lst_json_str "$ip")" "$count")")
    done

    printf '{"tool":"sys-health-audit","version":"%s","timestamp":"%s","hostname":%s,"kernel":%s,"uptime_seconds":%s,"status":"%s","exit_code":%s,' \
        "$LST_VERSION" "$(lst_timestamp)" "$(lst_json_str "$HOST")" "$(lst_json_str "$KERNEL")" \
        "$UPTIME_SECS" "$STATUS" "$EXIT_CODE"
    printf '"metrics":{'
    printf '"cpu":{"count":%s,"load_1m":%s,"load_5m":%s,"load_15m":%s,"load_pct":%s,"status":"%s"},' \
        "$CPU_COUNT" "$LOAD_1" "$LOAD_5" "$LOAD_15" "$LOAD_PCT" "$CPU_STATUS"
    printf '"memory":{"total_kib":%s,"available_kib":%s,"used_kib":%s,"used_pct":%s,"status":"%s"},' \
        "$MEM_TOTAL" "$MEM_AVAIL" "$MEM_USED" "$MEM_PCT" "$MEM_STATUS"
    printf '"swap":{"total_kib":%s,"used_kib":%s,"used_pct":%s,"status":"%s"},' \
        "$SWAP_TOTAL" "$SWAP_USED" "$SWAP_PCT" "$SWAP_STATUS"
    printf '"disks":%s,"disk_status":"%s","inode_status":"%s",' \
        "$(lst_json_join "${disks[@]}")" "$DISK_STATUS" "$INODE_STATUS"
    printf '"systemd":{"failed_units":%s,"status":"%s"},' \
        "$(lst_json_strs "${FAILED_UNITS[@]}")" "$SYSTEMD_STATUS"
    printf '"zombies":{"count":%s,"processes":%s,"status":"%s"},' \
        "${#Z_PID[@]}" "$(lst_json_join "${zombies[@]}")" "$ZOMBIE_STATUS"
    printf '"ssh":{"failed_logins_24h":%s,"top_sources":%s,"status":"%s"}' \
        "$SSH_FAILS" "$(lst_json_join "${top[@]}")" "$SSH_STATUS"
    printf '}}\n'
}

# ==============================================================================
# Text report
# ==============================================================================

# mark <status>: trailing marker for a non-OK tree line.
mark() {
    [[ "$1" == OK ]] || printf '  %s' "$(lst_status_color "$1")"
}

render_text() {
    local i lines=() mount_list=() extra ip count

    lst_header 'SYSTEM HEALTH & SECURITY POSTURE AUDIT'
    printf 'Host: %s%s%s | Kernel: %s%s%s | Uptime: %s%dd %dh %dm%s\n\n' \
        "$C_CYAN" "$HOST" "$C_RESET" "$C_CYAN" "$KERNEL" "$C_RESET" "$C_CYAN" \
        $(( UPTIME_SECS / 86400 )) $(( UPTIME_SECS % 86400 / 3600 )) $(( UPTIME_SECS % 3600 / 60 )) "$C_RESET"

    lst_row "$CPU_STATUS" 'CPU Load' \
        "1m: ${LOAD_1}, 5m: ${LOAD_5}, 15m: ${LOAD_15} (${CPU_COUNT} CPUs, ${LOAD_PCT}% of capacity)"
    lst_row "$MEM_STATUS" 'Memory (RAM)' \
        "$(lst_fmt_kib "$MEM_USED") / $(lst_fmt_kib "$MEM_TOTAL") (${MEM_PCT}% used)"
    if (( SWAP_TOTAL > 0 )); then
        lst_row "$SWAP_STATUS" 'Swap Space' \
            "$(lst_fmt_kib "$SWAP_USED") / $(lst_fmt_kib "$SWAP_TOTAL") (${SWAP_PCT}% used)"
    else
        lst_row "$SWAP_STATUS" 'Swap Space' 'No swap configured'
    fi

    if (( ${#D_SRC[@]} == 0 )); then
        lst_row INFO 'Disk Storage' 'No local block filesystems found'
    else
        lst_row "$DISK_STATUS" 'Disk Storage' "${#D_SRC[@]} filesystem(s) audited"
        lines=()
        for i in "${!D_SRC[@]}"; do
            mapfile -t mount_list <<< "${D_MOUNTS[i]}"
            extra=''
            (( ${#mount_list[@]} > 1 )) && extra=" (+$(( ${#mount_list[@]} - 1 )) more mounts)"
            lines+=("${mount_list[0]} [${D_TYPE[i]}]: $(lst_fmt_kib "${D_USED[i]}") / $(lst_fmt_kib "${D_SIZE[i]}") (${D_PCT[i]}% used)${extra}$(mark "${D_STATUS[i]}")")
        done
        lst_tree "${lines[@]}"

        lst_row "$INODE_STATUS" 'Inode Table' 'Inode usage per filesystem'
        lines=()
        for i in "${!D_SRC[@]}"; do
            mapfile -t mount_list <<< "${D_MOUNTS[i]}"
            if [[ -z "${I_PCT[i]}" ]]; then
                lines+=("${mount_list[0]} [${D_TYPE[i]}]: dynamic allocation (no fixed limit)")
            else
                lines+=("${mount_list[0]} [${D_TYPE[i]}]: ${I_USED[i]} / ${I_TOTAL[i]} (${I_PCT[i]}% used)$(mark "${I_STATUS[i]}")")
            fi
        done
        lst_tree "${lines[@]}"
    fi

    case "$SYSTEMD_STATUS" in
        SKIP) lst_row SKIP 'Systemd Units' 'systemd is not PID 1' ;;
        OK)   lst_row OK 'Systemd Units' 'No failed units' ;;
        *)    lst_row CRIT 'Systemd Units' "${#FAILED_UNITS[@]} failed unit(s)"
              lst_tree "${FAILED_UNITS[@]}" ;;
    esac

    if (( ${#Z_PID[@]} == 0 )); then
        lst_row OK 'Process Table' 'No zombie processes'
    else
        lst_row WARN 'Process Table' "${#Z_PID[@]} zombie process(es); fix or restart the parent to reap"
        lines=()
        for i in "${!Z_PID[@]}"; do
            lines+=("PID ${Z_PID[i]} (${Z_COMM[i]}) ← parent PID ${Z_PPID[i]} (${Z_PARENT[i]})")
        done
        lst_tree "${lines[@]}"
    fi

    if [[ "$SSH_STATUS" == SKIP ]]; then
        lst_row SKIP 'Security (SSH)' "$SSH_NOTE"
    else
        lst_row "$SSH_STATUS" 'Security (SSH)' "${SSH_FAILS} failed login attempt(s) in last 24h"
        lines=()
        for i in "${SSH_TOP[@]}"; do
            IFS=$'\t' read -r ip count <<< "$i"
            lines+=("${ip}: ${count} attempt(s)")
        done
        (( ${#lines[@]} == 0 )) || lst_tree "${lines[@]}"
    fi

    lst_rule '-'
    case "$STATUS" in
        OK)   printf 'Audit Result: %s%sSYSTEM IS HEALTHY (EXIT 0)%s\n' "$C_GREEN" "$C_BOLD" "$C_RESET" ;;
        WARN) printf 'Audit Result: %s%sWARNINGS DETECTED (EXIT 1)%s\n' "$C_YELLOW" "$C_BOLD" "$C_RESET" ;;
        CRIT) printf 'Audit Result: %s%sCRITICAL ISSUES REQUIRE ATTENTION (EXIT 2)%s\n' "$C_RED" "$C_BOLD" "$C_RESET" ;;
    esac
    lst_rule '='
}

if (( JSON )); then
    render_json
else
    render_text
fi
exit "$EXIT_CODE"
