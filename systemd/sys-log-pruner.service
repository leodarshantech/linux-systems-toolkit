[Unit]
Description=Emergency log cleanup when the log filesystem fills up
Documentation=https://github.com/leodarshantech/linux-systems-toolkit

[Service]
Type=oneshot
# Exits 1 if the filesystem is still above the threshold after pruning, so the
# unit shows up as failed (and in sys-health-audit) for a human to look at.
ExecStart=/usr/local/bin/sys-log-pruner --threshold 90 --journal-size 500M --max-age 7

# --- Least privilege ---------------------------------------------------------
# Deleting rotated logs owned by service users (e.g. /var/log/nginx) needs
# DAC override; nothing else is kept.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/log
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0077

PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
